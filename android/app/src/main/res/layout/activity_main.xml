<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0f1a">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <!-- Tap: the server's admin panel (games overview with join links, stats, metrics).
         Long-press: share the diagnostics bundle. -->
    <TextView
        android:id="@+id/admin_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:alpha="0.7"
        android:background="@drawable/admin_button_background"
        android:contentDescription="@string/admin_button"
        android:gravity="center"
        android:text="⚙"
        android:textColor="#F4E3D3"
        android:textSize="22sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/server_starting"
            android:textColor="#e8e0d4"
            android:textSize="16sp" />

        <Button
            android:id="@+id/share_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/share_diagnostics"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
